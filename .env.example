# SalesFlow CRM — environment (placeholders only, no real secrets)
NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

DATABASE_URL="postgresql://salesflow:salesflow@localhost:5432/salesflow?schema=public"
REDIS_URL="redis://localhost:6379"

JWT_SECRET=change-me-dev-access-secret-min-32-chars
REFRESH_SECRET=change-me-dev-refresh-secret-min-32-chars

# Email: Resend or SMTP (set one)
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@example.com

# Object storage (S3-compatible / MinIO)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=salesflow
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# Real-time (optional)
SOCKET_IO_ALLOWED_ORIGINS=http://localhost:3000

# Payments (STRIPE test mode only — no real charges)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AI adapter (optional, provider-independent)
AI_PROVIDER=stub
AI_API_KEY=
AI_BASE_URL=
