{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@salesflow/shared": ["../../packages/shared/src/index.ts"],
      "@salesflow/db": ["../../packages/db/src/index.ts"]
    }
  },
  "include": ["src/**/*"]
}
