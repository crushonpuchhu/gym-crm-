// GymFlow — Prisma schema
// Multi-tenant by organization: one organization is one gym brand.
// Every business record is scoped to organizationId. Soft delete via deletedAt.

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleKey {
  SUPER_ADMIN
  ORG_OWNER
  ORG_ADMIN
  CLUB_MANAGER
  MEMBERSHIP_ADVISOR
  SUPPORT_MANAGER
  SUPPORT_AGENT
  VIEWER
}

enum ProspectStatus {
  NEW
  CONTACTED
  TOUR_BOOKED
  TOURED
  TRIAL
  NEGOTIATING
  JOINED
  LOST
}

enum ProspectSource {
  WALK_IN
  WEBSITE
  REFERRAL
  INSTAGRAM
  FACEBOOK
  GOOGLE
  EVENT
  PARTNER
  OTHER
}

enum ProspectPriority {
  LOW
  MEDIUM
  HIGH
}

enum MemberStatus {
  TRIAL
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

enum MembershipStatus {
  PENDING
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  ANNUAL
  ONE_TIME
}

enum CheckInMethod {
  QR
  APP
  FRONT_DESK
}

enum TicketStatus {
  NEW
  OPEN
  PENDING
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketCategory {
  BILLING
  EQUIPMENT
  CLASS_BOOKING
  ACCESS
  CLEANLINESS
  STAFF
  OTHER
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ActivityType {
  CALL
  TOUR
  EMAIL
  TASK
  NOTE
  STATUS_CHANGE
  ASSIGNMENT
  CHECK_IN
}

enum NotificationType {
  ASSIGNMENT
  FOLLOW_UP
  MEMBERSHIP_UPDATE
  TICKET_UPDATE
  SLA_WARNING
  MENTION
  RENEWAL
  SYSTEM
}

enum SubscriptionPlan {
  STARTER
  GROWTH
  SCALE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIAL
  EXPIRED
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(200)
  slug      String   @unique @db.VarChar(100)
  plan      SubscriptionPlan @default(STARTER)
  status    String   @default("active") // active, suspended
  currency  String   @default("USD") @db.VarChar(3)
  timezone  String   @default("America/New_York") @db.VarChar(64)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  team          TeamMembership[]
  locations     Location[]
  members       Member[]
  prospects     Prospect[]
  plans         MembershipPlan[]
  pipelines     Pipeline[]
  memberships   Membership[]
  checkIns      CheckIn[]
  tickets       Ticket[]
  tasks         Task[]
  activities    Activity[]
  notifications Notification[]
  workflows     Workflow[]
  subscriptions Subscription[]
  auditLogs     AuditLog[]
  platformAuditLogs PlatformAuditLog[]
  invitations   Invitation[]
  roles         Role[]

  @@index([deletedAt])
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique @db.VarChar(255)
  passwordHash  String   @db.VarChar(255)
  name          String   @db.VarChar(200)
  avatarUrl     String?
  emailVerified Boolean  @default(false)
  /// GymFlow staff (vendor side): sees the platform console, never tenant records by default.
  isPlatformAdmin Boolean @default(false)
  /// Disabled accounts keep their data but cannot sign in or refresh.
  isActive      Boolean  @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  team                TeamMembership[]
  ownedProspects      Prospect[]        @relation("ProspectOwner")
  ownedMembers        Member[]          @relation("MemberOwner")
  ownedMemberships    Membership[]      @relation("MembershipOwner")
  ownedTickets        Ticket[]          @relation("TicketOwner")
  ownedTasks          Task[]            @relation("TaskOwner")
  prospectActivities  ProspectActivity[] @relation("ProspectActivityAuthor")
  ticketComments      TicketComment[]   @relation("TicketCommentAuthor")
  membershipHistories MembershipStageHistory[] @relation("MembershipStageHistoryChanger")
  activities          Activity[]        @relation("ActivityActor")
  notifications       Notification[]    @relation("NotificationRecipient")
  auditLogs           AuditLog[]        @relation("AuditLogActor")
  platformActions     PlatformAuditLog[] @relation("PlatformAuditActor")
  platformTargets     PlatformAuditLog[] @relation("PlatformAuditTarget")
  createdInvitations  Invitation[]      @relation("InvitationCreator")
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  refreshTokens       RefreshToken[]

  @@index([deletedAt])
}

/// Staff access to a gym brand. Replaces the old "membership" join table.
model TeamMembership {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  organizationId String  @db.Uuid
  role          RoleKey  @default(MEMBERSHIP_ADVISOR)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([deletedAt])
}

model Role {
  id            String   @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  name          String   @db.VarChar(100)
  key           RoleKey
  permissions   Json      @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(100)
  description String   @db.VarChar(255)
  createdAt   DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenId   String   @unique @db.VarChar(64)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Invitation {
  id            String   @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  email         String   @db.VarChar(255)
  role          RoleKey
  token         String   @unique
  expiresAt     DateTime
  acceptedAt    DateTime?
  createdById   String   @db.Uuid
  createdAt     DateTime @default(now())

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy     User       @relation("InvitationCreator", fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([token])
}

/// A branch or club. Members, memberships, classes and check-ins belong to one.
model Location {
  id            String   @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  name          String   @db.VarChar(200)
  address       String?  @db.VarChar(500)
  city          String?  @db.VarChar(100)
  region        String?  @db.VarChar(100)
  phone         String?  @db.VarChar(50)
  email         String?  @db.VarChar(255)
  capacity      Int?     @default(0)
  opensAt       String?  @db.VarChar(5)
  closesAt      String?  @db.VarChar(5)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      Member[]
  prospects    Prospect[]
  memberships  Membership[]
  checkIns     CheckIn[]
  tickets      Ticket[]

  @@index([organizationId])
  @@index([deletedAt])
}

/// Sellable membership product: day pass, monthly, annual, PT pack.
model MembershipPlan {
  id            String   @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  name          String   @db.VarChar(120)
  description   String?  @db.VarChar(500)
  price         Decimal  @db.Decimal(10, 2)
  billingCycle  BillingCycle @default(MONTHLY)
  durationDays  Int      @default(30)
  color         String   @db.VarChar(20) @default("#4f46e5")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  Membership[]

  @@index([organizationId])
  @@index([deletedAt])
}

/// A person with a membership or a trial. The gym's customer record.
model Member {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @db.Uuid
  ownerId           String   @db.Uuid
  locationId        String?  @db.Uuid
  firstName         String   @db.VarChar(100)
  lastName          String   @db.VarChar(100)
  email             String?  @db.VarChar(255)
  phone             String?  @db.VarChar(50)
  dateOfBirth       DateTime?
  address           String?  @db.VarChar(500)
  emergencyContact  String?  @db.VarChar(200)
  fitnessGoal       String?  @db.VarChar(200)
  status            MemberStatus @default(ACTIVE)
  joinedAt          DateTime?
  notes             String?  @db.VarChar(2000)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User         @relation("MemberOwner", fields: [ownerId], references: [id])
  location     Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  memberships  Membership[]
  checkIns     CheckIn[]
  tickets      Ticket[]
  convertedProspect Prospect? @relation("ProspectConvertedMember")

  @@index([organizationId])
  @@index([ownerId])
  @@index([locationId])
  @@index([status])
  @@index([deletedAt])
}

/// An enquiry, guest pass or trial that has not become a paying member yet.
model Prospect {
  id                String     @id @default(uuid()) @db.Uuid
  organizationId    String     @db.Uuid
  ownerId           String     @db.Uuid
  locationId        String?    @db.Uuid
  firstName         String     @db.VarChar(100)
  lastName          String     @db.VarChar(100)
  email             String?    @db.VarChar(255)
  phone             String?    @db.VarChar(50)
  source            ProspectSource @default(WALK_IN)
  status            ProspectStatus @default(NEW)
  priority          ProspectPriority @default(MEDIUM)
  score             Int        @default(0)
  /// Expected monthly revenue if this prospect joins.
  value             Decimal?   @db.Decimal(12, 2)
  fitnessGoal       String?    @db.VarChar(200)
  followUpAt        DateTime?
  convertedMemberId String?    @unique @db.Uuid
  convertedMembershipId String? @unique @db.Uuid
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deletedAt         DateTime?

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner             User         @relation("ProspectOwner", fields: [ownerId], references: [id])
  location          Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  activities        ProspectActivity[]
  convertedMember   Member?      @relation("ProspectConvertedMember", fields: [convertedMemberId], references: [id])
  convertedMembership Membership? @relation("ProspectConvertedMembership", fields: [convertedMembershipId], references: [id])

  @@index([organizationId])
  @@index([ownerId])
  @@index([locationId])
  @@index([status])
  @@index([deletedAt])
}

model ProspectActivity {
  id        String   @id @default(uuid()) @db.Uuid
  prospectId String  @db.Uuid
  authorId  String   @db.Uuid
  type      ActivityType
  subject   String   @db.VarChar(200)
  body      String?
  occurredAt DateTime @default(now())
  createdAt DateTime @default(now())

  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  author   User     @relation("ProspectActivityAuthor", fields: [authorId], references: [id])

  @@index([prospectId])
  @@index([authorId])
}

model Pipeline {
  id          String   @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  name        String   @db.VarChar(200)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages      PipelineStage[]
  memberships Membership[]

  @@index([organizationId])
  @@index([deletedAt])
}

model PipelineStage {
  id        String   @id @default(uuid()) @db.Uuid
  pipelineId String  @db.Uuid
  name      String   @db.VarChar(100)
  key       String   @db.VarChar(100)
  order     Int
  probability Int    @default(0)
  isWon     Boolean  @default(false)
  isLost    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  pipeline Pipeline  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  memberships Membership[]
  historyFrom MembershipStageHistory[] @relation("HistoryFromStage")
  historyTo   MembershipStageHistory[] @relation("HistoryToStage")

  @@index([pipelineId])
  @@index([key])
}

/// A membership contract in motion or active. The Kanban card is a contract.
model Membership {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  pipelineId      String   @db.Uuid
  stageId         String   @db.Uuid
  ownerId         String   @db.Uuid
  memberId        String?  @db.Uuid
  planId          String?  @db.Uuid
  locationId      String?  @db.Uuid
  title           String   @db.VarChar(200)
  /// Total contract value across the full term.
  value           Decimal  @db.Decimal(12, 2)
  /// Recurring monthly revenue used for MRR.
  monthlyValue    Decimal  @db.Decimal(10, 2) @default(0)
  billingCycle    BillingCycle @default(MONTHLY)
  status          MembershipStatus @default(PENDING)
  probability     Int      @default(0)
  expectedCloseAt DateTime?
  startDate       DateTime?
  endDate         DateTime?
  wonAt           DateTime?
  lostAt          DateTime?
  cancelledAt     DateTime?
  wonReason       String?  @db.VarChar(500)
  cancelReason    String?  @db.VarChar(500)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline      Pipeline       @relation(fields: [pipelineId], references: [id])
  stage         PipelineStage  @relation(fields: [stageId], references: [id])
  owner         User           @relation("MembershipOwner", fields: [ownerId], references: [id])
  member        Member?        @relation(fields: [memberId], references: [id], onDelete: SetNull)
  plan          MembershipPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  location      Location?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  stageHistory  MembershipStageHistory[]
  convertedProspect Prospect? @relation("ProspectConvertedMembership")

  @@index([organizationId])
  @@index([pipelineId])
  @@index([stageId])
  @@index([ownerId])
  @@index([memberId])
  @@index([status])
  @@index([deletedAt])
}

model MembershipStageHistory {
  id          String   @id @default(uuid()) @db.Uuid
  membershipId String  @db.Uuid
  fromStageId String?  @db.Uuid
  toStageId   String   @db.Uuid
  changedById String   @db.Uuid
  changedAt   DateTime @default(now())

  membership  Membership      @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  fromStage   PipelineStage?  @relation("HistoryFromStage", fields: [fromStageId], references: [id], onDelete: SetNull)
  toStage     PipelineStage   @relation("HistoryToStage", fields: [toStageId], references: [id])
  changedBy   User            @relation("MembershipStageHistoryChanger", fields: [changedById], references: [id])

  @@index([membershipId])
  @@index([changedAt])
}

/// Front-desk, app or QR entry. Drives attendance and retention reporting.
model CheckIn {
  id            String   @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  memberId      String   @db.Uuid
  locationId    String   @db.Uuid
  method        CheckInMethod @default(FRONT_DESK)
  checkedInAt   DateTime @default(now())
  durationMinutes Int?
  createdAt     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([organizationId, checkedInAt])
  @@index([memberId])
  @@index([locationId])
}

/// Member support: billing questions, broken equipment, access issues.
model Ticket {
  id            String   @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  ticketNumber  String   @db.VarChar(50)
  reporterName  String   @db.VarChar(100)
  reporterEmail String   @db.VarChar(255)
  memberId      String?  @db.Uuid
  locationId    String?  @db.Uuid
  ownerId       String?  @db.Uuid
  category      TicketCategory @default(OTHER)
  priority      TicketPriority @default(MEDIUM)
  status        TicketStatus @default(NEW)
  subject       String   @db.VarChar(200)
  description   String   @db.VarChar(2000)
  firstResponseAt DateTime?
  resolvedAt    DateTime?
  closedAt      DateTime?
  slaDueAt      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  member       Member?      @relation(fields: [memberId], references: [id], onDelete: SetNull)
  location     Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  owner        User?        @relation("TicketOwner", fields: [ownerId], references: [id])
  comments     TicketComment[]

  @@index([organizationId])
  @@index([ticketNumber])
  @@unique([organizationId, ticketNumber])
  @@index([ownerId])
  @@index([status])
  @@index([deletedAt])
}

model TicketComment {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  String   @db.Uuid
  authorId  String   @db.Uuid
  body      String   @db.VarChar(4000)
  isInternal Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  ticket   Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author   User      @relation("TicketCommentAuthor", fields: [authorId], references: [id])
  attachments TicketAttachment[]

  @@index([ticketId])
  @@index([authorId])
  @@index([deletedAt])
}

model TicketAttachment {
  id         String  @id @default(uuid()) @db.Uuid
  ticketCommentId String @db.Uuid
  fileName   String  @db.VarChar(255)
  fileUrl    String  @db.VarChar(500)
  fileSize   Int
  mimeType   String  @db.VarChar(100)
  createdAt  DateTime @default(now())

  comment TicketComment @relation(fields: [ticketCommentId], references: [id], onDelete: Cascade)

  @@index([ticketCommentId])
}

model Task {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @db.Uuid
  title             String   @db.VarChar(200)
  type              ActivityType @default(TASK)
  ownerId           String   @db.Uuid
  dueAt             DateTime?
  reminderAt        DateTime?
  status            TaskStatus @default(OPEN)
  relatedEntityType String?  @db.VarChar(50)
  relatedEntityId   String?  @db.Uuid
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner       User      @relation("TaskOwner", fields: [ownerId], references: [id])

  @@index([organizationId])
  @@index([ownerId])
  @@index([status])
  @@index([deletedAt])
}

model Activity {
  id          String   @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  actorId     String   @db.Uuid
  type        ActivityType
  subject     String   @db.VarChar(200)
  entityType  String   @db.VarChar(50)
  entityId    String   @db.Uuid
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor       User     @relation("ActivityActor", fields: [actorId], references: [id])

  @@index([organizationId])
  @@index([actorId])
  @@index([entityType, entityId])
}

model Notification {
  id          String   @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  userId      String   @db.Uuid
  type        NotificationType
  title       String   @db.VarChar(200)
  body        String   @db.VarChar(1000)
  data        Json?
  readAt      DateTime?
  createdAt   DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user        User     @relation("NotificationRecipient", fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([readAt])
}

model Workflow {
  id          String   @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  name        String   @db.VarChar(200)
  trigger     String   @db.VarChar(100)
  condition   Json      @default("{}")
  actions     Json      @default("[]")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  executions  WorkflowExecution[]

  @@index([organizationId])
}

model WorkflowExecution {
  id          String   @id @default(uuid()) @db.Uuid
  workflowId  String   @db.Uuid
  triggerEvent String  @db.VarChar(100)
  status      String   @db.VarChar(50) // success, failed, retry
  input       Json?
  output      Json?
  error       String?  @db.VarChar(1000)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([status])
}

model Subscription {
  id                String             @id @default(uuid()) @db.Uuid
  organizationId    String             @db.Uuid
  plan              SubscriptionPlan   @default(STARTER)
  status            SubscriptionStatus @default(TRIAL)
  currentPeriodEnd  DateTime?
  /// When a TRIAL stops being free. Null on comped or legacy rows.
  trialEndsAt       DateTime?
  quotaMembers      Int                @default(500)
  quotaStaff        Int                @default(5)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  userId      String?   @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String   @db.VarChar(100)
  entityId    String?  @db.Uuid
  oldValues   Json?
  newValues   Json?
  ip          String?  @db.VarChar(45)
  userAgent   String?  @db.VarChar(500)
  createdAt   DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user        User?     @relation("AuditLogActor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

/// Vendor-side, append-only trail. Separate from AuditLog so customers never see
/// internal operator notes or support access history.
model PlatformAuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  actorUserId    String   @db.Uuid
  action         String   @db.VarChar(100)
  organizationId String?  @db.Uuid
  targetUserId   String?  @db.Uuid
  metadata       Json?
  ip             String?  @db.VarChar(45)
  userAgent      String?  @db.VarChar(500)
  createdAt      DateTime @default(now())

  actor        User          @relation("PlatformAuditActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  targetUser   User?         @relation("PlatformAuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([organizationId])
  @@index([createdAt])
}
